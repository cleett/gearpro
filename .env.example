# 소셜 로그인 공급자 (각 콘솔에서 OAuth 앱 생성, README 참고)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Better Auth
BETTER_AUTH_URL=https://auth.gearpro.kr
BETTER_AUTH_SECRET=

# 리뷰어 자가 등록용 GitHub 토큰 (repo: contents write)
GITHUB_TOKEN=

# 첫 관리자 자동 승격 이메일 (쉼표 구분)
ADMIN_EMAILS=

# Keystatic GitHub 모드 (Admin UI 첫 실행 시 자동 생성되는 값)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# 프로덕션 GitHub 저장소 (owner/repo) — wrangler.jsonc 권장
KEYSTATIC_GITHUB_REPO=

# 공개 사이트 URL (RSS·사이트맵) — wrangler.jsonc 권장
SITE_URL=

# Google Analytics / Google tag (빌드 시 주입, G- 또는 GT-)
PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager (선택, GTM-). 설정하면 GA4 직접 삽입 대신 GTM을 사용합니다.
PUBLIC_GTM_ID=

# 리뷰어 보상 리포트/메트릭 서명용 시크릿 (32+ 자리 랜덤 문자열 권장)
# openssl rand -hex 32
METRICS_SECRET=
