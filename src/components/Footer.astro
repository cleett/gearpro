---
import { getCollection } from 'astro:content';

import { buildTaxonomy } from '../lib/taxonomy';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/site';

const categories = await getCollection('categories');
const taxonomy = buildTaxonomy(categories);

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-display text-2xl font-semibold tracking-tight">
        {SITE_NAME}<span class="text-signal">.</span>
      </p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-soft">{SITE_DESCRIPTION}</p>
    </div>
    <div>
      <p class="eyebrow text-soft">카테고리</p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          taxonomy.topLevel.map((category) => (
            <li>
              <a
                href={`/categories/${category.id}/`}
                class="text-soft transition-colors hover:text-ink"
              >
                {category.data.name}
              </a>
              {taxonomy.childrenOf.get(category.id)?.length ? (
                <span class="ml-2 text-xs text-line">
                  {taxonomy.childrenOf
                    .get(category.id)!
                    .map((slug) => taxonomy.nameOf(slug))
                    .join(' · ')}
                </span>
              ) : null}
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="eyebrow text-soft">바로가기</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/reviews/" class="text-soft transition-colors hover:text-ink">전체 리뷰</a></li>
        <li><a href="/rankings/" class="text-soft transition-colors hover:text-ink">기어 랭킹</a></li>
        <li><a href="/about/" class="text-soft transition-colors hover:text-ink">리뷰 원칙</a></li>
        <li><a href="/rss.xml" class="text-soft transition-colors hover:text-ink">RSS 피드</a></li>
        <li><a href="/reviewer/" class="font-medium text-ink transition-colors hover:text-signal-deep">리뷰어 지원 →</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-x-6 gap-y-2 px-5 py-5 text-xs text-soft sm:flex-row sm:items-center"
    >
      <p>© {year} {SITE_NAME}. All rights reserved.</p>
      <nav aria-label="법적 고지" class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href="/terms/" class="transition-colors hover:text-ink">이용약관</a>
        <a href="/privacy/" class="transition-colors hover:text-ink">개인정보처리방침</a>
      </nav>
      <p class="hidden lg:block">내돈내산과 스폰서 리뷰를 항상 구분해 표시합니다.</p>
    </div>
  </div>
</footer>
