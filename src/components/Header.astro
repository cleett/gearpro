---
import { SITE_NAME } from '../lib/site';

const { pathname } = Astro.url;
const links = [
  { href: '/reviews/', label: '리뷰' },
  { href: '/rankings/', label: '랭킹' },
  { href: '/about/', label: '소개' },
  { href: '/rss.xml', label: 'RSS' },
];

const isActive = (href: string) =>
  href === '/rss.xml' ? false : pathname === href || pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5">
    <a href="/" class="font-display text-2xl font-semibold tracking-tight">
      {SITE_NAME}<span class="text-signal">.</span>
    </a>
    <nav class="flex items-center gap-6" aria-label="주 메뉴">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'text-ink underline decoration-signal decoration-2 underline-offset-8'
                : 'text-soft hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
