---
import BaseLayout from './Base.astro';

interface LegalFrontmatter {
  title: string;
  description: string;
  eyebrow?: string;
  effectiveDate: string | Date;
  revisedDate?: string | Date;
  version?: string;
  contactEmail?: string;
  doc?: 'privacy' | 'terms';
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props extends Partial<LegalFrontmatter> {
  frontmatter?: LegalFrontmatter;
  headings?: Heading[];
}

// MDX page layouts receive frontmatter under `frontmatter`; Astro components pass props directly.
const {
  title,
  description,
  eyebrow = '정책',
  effectiveDate,
  revisedDate,
  version = '1.0',
  contactEmail = 'privacy@gearpro.kr',
  doc,
} = (Astro.props.frontmatter ?? Astro.props) as LegalFrontmatter;

const headings = ((Astro.props.headings ?? []) as Heading[]).filter(
  (heading) => heading.depth === 2,
);

const toKstDate = (value: string | Date) => {
  const iso = value instanceof Date ? value.toISOString() : value;
  return new Date(`${iso.slice(0, 10)}T00:00:00+09:00`);
};

const formatEffective = (value: string | Date) =>
  toKstDate(value).toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Asia/Seoul',
  });

const effective = formatEffective(effectiveDate);
const revised = revisedDate ? formatEffective(revisedDate) : null;

const docs = [
  { key: 'terms', href: '/terms/', label: '이용약관' },
  { key: 'privacy', href: '/privacy/', label: '개인정보처리방침' },
] as const;

const relatedDocs = docs.filter((entry) => entry.key !== doc);
---

<BaseLayout title={title} description={description}>
  <div id="top" class="mx-auto max-w-6xl px-5 pt-10 pb-20">
    <nav aria-label="현재 위치" class="flex items-center gap-2 text-sm text-soft">
      <a href="/" class="transition-colors hover:text-ink">홈</a>
      <span class="text-line" aria-hidden>›</span>
      <span class="text-ink">{title}</span>
    </nav>

    <header class="mt-8 max-w-3xl">
      <p class="eyebrow text-signal-deep">{eyebrow}</p>
      <h1 class="mt-4 font-display text-4xl font-semibold leading-[1.12] tracking-tight md:text-5xl">
        {title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-soft">{description}</p>

      <dl class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
        <div class="bg-surface px-5 py-4">
          <dt class="eyebrow text-soft">시행일</dt>
          <dd class="mt-2 text-sm font-medium tabular-nums">{effective}</dd>
        </div>
        <div class="bg-surface px-5 py-4">
          <dt class="eyebrow text-soft">버전</dt>
          <dd class="mt-2 text-sm font-medium tabular-nums">v{version}</dd>
        </div>
        <div class="bg-surface px-5 py-4">
          <dt class="eyebrow text-soft">문의</dt>
          <dd class="mt-2 text-sm font-medium">
            <a
              href={`mailto:${contactEmail}`}
              class="underline decoration-line underline-offset-4 transition-colors hover:text-signal-deep"
            >
              {contactEmail}
            </a>
          </dd>
        </div>
      </dl>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_280px] lg:items-start">
      <article class="legal-prose prose prose-review max-w-none">
        <slot />
      </article>

      <aside
        class="space-y-4 lg:sticky lg:top-24 lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto lg:pr-1"
        aria-label="문서 정보"
      >
        {
          headings.length > 0 && (
            <nav class="rounded-2xl border border-line bg-surface p-5" aria-label="목차">
              <p class="eyebrow text-soft">목차</p>
              <ol class="mt-4 space-y-2 text-sm">
                {headings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="block text-soft transition-colors hover:text-ink"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="rounded-2xl border border-line bg-surface p-5">
          <p class="eyebrow text-soft">문서 정보</p>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-soft">시행일</dt>
              <dd class="text-right font-medium tabular-nums">{effective}</dd>
            </div>
            {
              revised && (
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-soft">최종 개정</dt>
                  <dd class="text-right font-medium tabular-nums">{revised}</dd>
                </div>
              )
            }
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-soft">버전</dt>
              <dd class="text-right font-medium tabular-nums">v{version}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-soft">언어</dt>
              <dd class="text-right font-medium">한국어</dd>
            </div>
          </dl>
        </div>

        <div class="rounded-2xl border border-line bg-surface p-5">
          <p class="eyebrow text-soft">관련 문서</p>
          <ul class="mt-4 space-y-2 text-sm">
            {
              relatedDocs.map((entry) => (
                <li>
                  <a
                    href={entry.href}
                    class="group flex items-center justify-between gap-3 font-medium text-ink transition-colors hover:text-signal-deep"
                  >
                    {entry.label}
                    <span
                      class="text-soft transition-transform group-hover:translate-x-0.5"
                      aria-hidden
                    >
                      →
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-2xl bg-ink p-5 text-paper">
          <p class="eyebrow text-paper/50">문의</p>
          <p class="mt-3 text-sm leading-relaxed text-paper/75">
            문서 내용이나 개인정보 처리에 대해 궁금한 점이 있다면 언제든 알려주세요.
          </p>
          <a
            href={`mailto:${contactEmail}`}
            class="mt-3 inline-block break-all text-sm font-semibold text-signal underline decoration-signal/40 underline-offset-4 transition-colors hover:text-paper"
          >
            {contactEmail}
          </a>
        </div>

        <a
          href="#top"
          class="inline-flex text-xs font-medium text-soft transition-colors hover:text-ink"
        >
          ↑ 맨 위로
        </a>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-prose {
    word-break: keep-all;
  }

  .legal-prose :global(h2) {
    margin-top: 2.6em;
    border-top: 1px solid var(--color-line);
    padding-top: 1.15em;
    font-size: 1.45rem;
    line-height: 1.35;
    scroll-margin-top: 6rem;
  }

  .legal-prose :global(h3) {
    margin-top: 1.9em;
    font-size: 1.1rem;
  }

  .legal-prose :global(li) {
    margin-top: 0.35em;
    margin-bottom: 0.35em;
  }

  .legal-prose :global(ul > li::marker) {
    color: var(--color-signal);
  }

  .legal-prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .legal-prose :global(th) {
    background-color: var(--color-surface);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .legal-prose :global(th),
  .legal-prose :global(td) {
    padding: 0.65rem 0.8rem;
  }

  @media print {
    .legal-prose :global(h2) {
      break-after: avoid;
    }

    .legal-prose :global(table) {
      overflow: visible;
    }
  }
</style>
