---
import BaseLayout from '../layouts/Base.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-5 py-32 text-center">
    <p class="font-display text-8xl font-semibold text-signal">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight md:text-4xl">
      길을 잃으셨나요?
    </h1>
    <p class="mt-3 max-w-md text-soft">
      요청하신 페이지가 존재하지 않거나, 다른 곳으로 이동했습니다.
    </p>
    <a
      href="/"
      class="mt-8 rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition hover:bg-signal-deep"
    >
      홈으로 돌아가기
    </a>
  </section>
</BaseLayout>
