---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import ReviewCard from '../components/ReviewCard.astro';
import FundingPill from '../components/FundingPill.astro';
import BaseLayout from '../layouts/Base.astro';
import { buildTaxonomy, byDateDesc } from '../lib/taxonomy';
import { formatDate, formatPrice } from '../lib/site';

const reviews = (await getCollection('reviews')).sort(byDateDesc);
const categories = await getCollection('categories');
const taxonomy = buildTaxonomy(categories);
const authorNames = new Map((await getCollection('authors')).map((a) => [a.id, a.data.name]));

const featured = reviews.find((r) => r.data.featured) ?? reviews[0];
const latest = reviews.filter((r) => r.id !== featured.id).slice(0, 6);
const featuredAuthor = authorNames.get(featured.data.author);
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-14 md:pt-24 md:pb-20">
    <p class="eyebrow text-signal-deep">독립 기어 리뷰 매거진</p>
    <h1
      class="mt-5 max-w-3xl font-display text-5xl font-semibold leading-[1.08] tracking-tight md:text-7xl"
    >
      직접 사서, 몇 달씩 쓰고, 결론만 전합니다.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-soft">
      보도자료 샘플도 없습니다. 모든 리뷰는 내돈내산과 스폰서(협찬)를 명확히 표시하고, 협찬 리뷰도
      같은 루브릭으로 점수를 매깁니다.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/reviews/"
        class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper transition hover:bg-signal-deep"
      >
        리뷰 읽기
      </a>
      <a
        href="/rankings/"
        class="rounded-full border border-ink/20 bg-transparent px-6 py-3 text-sm font-semibold text-ink transition hover:border-ink"
      >
        기어 랭킹 보기
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5" aria-labelledby="featured-heading">
    <div class="flex items-center gap-4">
      <h2 id="featured-heading" class="eyebrow text-soft">주목할 리뷰</h2>
      <div class="h-px flex-1 bg-line"></div>
    </div>
    <div class="mt-6 grid overflow-hidden rounded-3xl border border-line bg-surface md:grid-cols-2">
      <div class="relative min-h-64 border-b border-line md:border-r md:border-b-0">
        {
          featured.data.cover ? (
            <Image
              src={featured.data.cover}
              alt={`${featured.data.brand} ${featured.data.title}`}
              width={1200}
              loading="eager"
              class="absolute inset-0 h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full items-center justify-center bg-ink">
              <span class="font-display text-8xl font-semibold text-signal">
                {featured.data.brand[0]}
              </span>
            </div>
          )
        }
      </div>
      <div class="flex flex-col justify-center gap-4 p-8 md:p-12">
        <div class="flex items-center justify-between gap-4">
          <p class="flex items-center gap-2">
            <FundingPill funding={featured.data.funding} />
            <span class="eyebrow text-signal-deep">{taxonomy.labelOf(featured.data.category)}</span>
          </p>
          <div
            class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-xl bg-ink text-paper"
          >
            <span class="font-display text-xl font-semibold leading-none">
              {featured.data.rating.toFixed(1)}
            </span>
            <span class="mt-0.5 text-[9px] font-medium uppercase tracking-widest text-paper/50">
              / 10
            </span>
          </div>
        </div>
        <h3 class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
          {featured.data.brand} {featured.data.title}
        </h3>
        <p class="leading-relaxed text-soft">{featured.data.excerpt}</p>
        <p class="text-sm text-soft">
          {featuredAuthor ?? featured.data.author} · {formatDate(featured.data.publishedAt)} · {formatPrice(featured.data.price)}
        </p>
        <a
          href={`/reviews/${featured.id}/`}
          class="mt-2 inline-flex w-fit items-center gap-2 text-sm font-semibold text-ink underline decoration-signal decoration-2 underline-offset-4 transition hover:text-signal-deep"
        >
          리뷰 전문 읽기 →
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-16" aria-labelledby="latest-heading">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 id="latest-heading" class="font-display text-3xl font-semibold tracking-tight">
          최신 리뷰
        </h2>
        <p class="mt-1 text-sm text-soft">방금 테스트를 마친 제품들입니다.</p>
      </div>
      <a
        href="/reviews/"
        class="shrink-0 text-sm font-semibold text-ink underline decoration-signal decoration-2 underline-offset-4 transition hover:text-signal-deep"
      >
        전체 보기 →
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((review) => (
        <ReviewCard
          review={review}
          authorName={authorNames.get(review.data.author)}
          categoryLabel={taxonomy.labelOf(review.data.category)}
        />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-16" aria-labelledby="categories-heading">
    <div class="flex items-center gap-4">
      <h2 id="categories-heading" class="eyebrow text-soft">카테고리로 둘러보기</h2>
      <div class="h-px flex-1 bg-line"></div>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        taxonomy.topLevel.map((category) => (
          <a
            href={`/categories/${category.id}/`}
            class="rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-medium text-ink transition hover:border-ink hover:bg-ink hover:text-paper"
          >
            {category.data.name}
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-20">
    <div class="rounded-3xl bg-ink px-8 py-12 text-paper md:px-14 md:py-16">
      <div class="grid items-center gap-10 md:grid-cols-2">
        <div>
          <p class="eyebrow text-paper/50">기어프로가 다른 이유</p>
          <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
            믿고 읽을 수 있는 리뷰.
          </h2>
          <a
            href="/about/"
            class="mt-6 inline-flex items-center gap-2 text-sm font-semibold underline decoration-signal decoration-2 underline-offset-4 transition hover:text-signal"
          >
            리뷰 방식 보기 →
          </a>
        </div>
        <dl class="grid gap-8 sm:grid-cols-3">
          <div>
            <dt class="text-xs uppercase tracking-widest text-paper/50">테스트한 제품</dt>
            <dd class="mt-2 font-display text-4xl font-semibold">120+</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-paper/50">테스트 기간</dt>
            <dd class="mt-2 font-display text-4xl font-semibold">3–6 <span class="text-lg">개월</span></dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-paper/50">리뷰 성격 표시</dt>
            <dd class="mt-2 font-display text-4xl font-semibold">100%</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
