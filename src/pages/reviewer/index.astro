---
export const prerender = false;

import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/Base.astro';
import { getCfEnv } from '../../lib/auth';
import { getMetricsEnv, todayKST } from '../../lib/metrics';
import { estimateAmount, formatKrw, getRateCard } from '../../lib/reviewer';
import { ROLE_LABELS, hasAnyRole, hasRole, parseRoles, type Role } from '../../lib/roles';
import { ensureAdminBootstrap, getSessionUser } from '../../lib/session';

const cfEnv = await getCfEnv();
const authConfigured = !!cfEnv['BETTER_AUTH_SECRET'];
const authBase = (cfEnv['BETTER_AUTH_URL'] as string) ?? 'https://auth.gearpro.kr';

const providers = (['google', 'apple', 'kakao', 'naver'] as const).filter((p) =>
  !!cfEnv[`${p.toUpperCase()}_CLIENT_ID`],
);

interface ApplicationRow {
  id: number;
  status: string;
  note: string | null;
}

const sessionUser = await getSessionUser(Astro.request);
if (sessionUser) {
  await ensureAdminBootstrap(sessionUser);
}
const staff = hasAnyRole(sessionUser, ['editor', 'moderator', 'admin']);
const isModeratorOnly = sessionUser && !staff && hasRole(sessionUser, 'moderator');

const { db } = await getMetricsEnv();
const month = todayKST().slice(0, 7);
const prefix = `${month}-%`;

let application: ApplicationRow | null = null;
if (db && sessionUser && !staff) {
  try {
    application = await db
      .prepare('SELECT id, status, note FROM applications WHERE user_id = ?')
      .bind(sessionUser.id)
      .first<ApplicationRow>() ?? null;
  } catch {
    application = null;
  }
}

let authorSlug: string | null = null;
let authorName: string | null = null;
let onboarding = false;

if (db && sessionUser && hasAnyRole(sessionUser, ['editor', 'admin'])) {
  const mapped = await db
    .prepare('SELECT author, author_name FROM authors_auth WHERE email = ?')
    .bind(sessionUser.email)
    .first<{ author: string; author_name: string }>();
  if (mapped) {
    authorSlug = mapped.author;
    authorName = mapped.author_name;
  } else {
    onboarding = true;
  }
}

type PayoutRow = {
  id: number;
  month: string;
  views: number;
  likes: number;
  amount: number;
  status: string;
};

const reviews = authorSlug ? await getCollection('reviews') : [];
const titles = new Map(reviews.map((r) => [r.id, `${r.data.brand} ${r.data.title}`]));

type SlugStat = {
  slug: string;
  title: string;
  monthViews: number;
  monthLikes: number;
  allViews: number;
  allLikes: number;
};

let slugStats: SlugStat[] = [];
let totals = { monthViews: 0, monthLikes: 0, allViews: 0, allLikes: 0 };
let rates = { view: 0, like: 0, cap: 0 };
let estimate = 0;
let currentRequest: PayoutRow | null = null;
let history: PayoutRow[] = [];

if (db && authorSlug) {
  const mine = await db
    .prepare('SELECT slug FROM reviews WHERE author = ?')
    .bind(authorSlug)
    .all<{ slug: string }>();
  const slugs = (mine.results ?? []).map((r) => r.slug);

  const monthViews = new Map<string, number>();
  const monthLikes = new Map<string, number>();
  const allViews = new Map<string, number>();
  const allLikes = new Map<string, number>();

  if (slugs.length > 0) {
    const ph = slugs.map(() => '?').join(',');
    const mv = await db
      .prepare(
        `SELECT slug, SUM(n) AS n FROM views WHERE slug IN (${ph}) AND day LIKE ? GROUP BY slug`,
      )
      .bind(...slugs, prefix)
      .all<{ slug: string; n: number }>();
    for (const r of mv.results ?? []) monthViews.set(r.slug, r.n);
    const ml = await db
      .prepare(
        `SELECT slug, COUNT(*) AS n FROM votes WHERE slug IN (${ph}) AND day LIKE ? GROUP BY slug`,
      )
      .bind(...slugs, prefix)
      .all<{ slug: string; n: number }>();
    for (const r of ml.results ?? []) monthLikes.set(r.slug, r.n);
    const av = await db
      .prepare(`SELECT slug, SUM(n) AS n FROM views WHERE slug IN (${ph}) GROUP BY slug`)
      .bind(...slugs)
      .all<{ slug: string; n: number }>();
    for (const r of av.results ?? []) allViews.set(r.slug, r.n);
    const al = await db
      .prepare(`SELECT slug, COUNT(*) AS n FROM votes WHERE slug IN (${ph}) GROUP BY slug`)
      .bind(...slugs)
      .all<{ slug: string; n: number }>();
    for (const r of al.results ?? []) allLikes.set(r.slug, r.n);
  }

  slugStats = slugs.map((slug) => ({
    slug,
    title: titles.get(slug) ?? slug,
    monthViews: monthViews.get(slug) ?? 0,
    monthLikes: monthLikes.get(slug) ?? 0,
    allViews: allViews.get(slug) ?? 0,
    allLikes: allLikes.get(slug) ?? 0,
  }));

  for (const s of slugStats) {
    totals.monthViews += s.monthViews;
    totals.monthLikes += s.monthLikes;
    totals.allViews += s.allViews;
    totals.allLikes += s.allLikes;
  }

  rates = await getRateCard(db);
  estimate = estimateAmount(totals.monthViews, totals.monthLikes, rates);

  const reqs = await db
    .prepare('SELECT * FROM payout_requests WHERE author = ? ORDER BY month DESC')
    .bind(authorSlug)
    .all<PayoutRow>();
  history = reqs.results ?? [];
  currentRequest = history.find((r) => r.month === month) ?? null;
}

const statusLabel: Record<string, string> = {
  requested: '요청됨',
  paid: '지급완료',
  rejected: '거절됨',
};

const userRoles = parseRoles(sessionUser?.role);
---

<BaseLayout title="리뷰어 대시보드">
  <section class="mx-auto max-w-4xl px-5 pt-14 pb-20">
    <p class="eyebrow text-signal-deep">리뷰어 포털</p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight md:text-5xl">
      내 활동 대시보드
    </h1>

    {
      !authConfigured && (
        <div class="mt-8 rounded-2xl border border-line bg-surface p-6 text-sm leading-relaxed text-soft">
          인증 서버가 아직 설정되지 않았습니다. <code>BETTER_AUTH_SECRET</code>을 등록한 뒤 다시
          시도하세요.
        </div>
      )
    }

    {
      authConfigured && !sessionUser && (
        <div class="mt-8 rounded-2xl border border-line bg-surface p-6" data-auth-base={authBase}>
          <p class="font-display text-xl font-semibold">리뷰어 포털 로그인</p>
          <p class="mt-2 text-sm leading-relaxed text-soft">
            구글·애플·카카오·네이버 계정 또는 이메일로 가입하면 회원으로 등록됩니다. 에디터 활동은
            관리자 승인 후 활성화됩니다.
          </p>
          {
            providers.length > 0 ? (
              <div class="mt-5 flex flex-wrap gap-3">
                {providers.map((provider) => (
                  <button
                    type="button"
                    data-provider={provider}
                    class="rounded-full border border-ink/20 bg-surface px-5 py-2.5 text-sm font-semibold text-ink transition hover:border-ink"
                  >
                    {provider === 'google' && '구글로 계속하기'}
                    {provider === 'apple' && '애플로 계속하기'}
                    {provider === 'kakao' && '카카오로 계속하기'}
                    {provider === 'naver' && '네이버로 계속하기'}
                  </button>
                ))}
              </div>
            ) : (
              <p class="mt-5 rounded-xl border border-gold/40 bg-gold/10 p-3 text-sm">
                소셜 로그인 공급자가 아직 설정되지 않았습니다. 각 프로바이더 OAuth 앱을 만들고
                시크릿을 등록하세요. (README 참고)
              </p>
            )
          }
          <div class="mt-6 border-t border-line pt-5">
            <div class="grid grid-cols-2 gap-1 rounded-full bg-paper p-1" role="tablist" aria-label="이메일 로그인 / 회원가입">
              <button type="button" data-tab="signin" data-active="true" class="auth-tab" aria-selected="true">
                로그인
              </button>
              <button type="button" data-tab="signup" data-active="false" class="auth-tab" aria-selected="false">
                회원가입
              </button>
            </div>

            <div data-panel="signin">
              <form id="signin-form" class="mt-5 grid gap-4">
                <label class="text-sm">
                  <span class="font-medium">이메일 *</span>
                  <input name="email" type="email" required class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
                </label>
                <label class="text-sm">
                  <span class="font-medium">비밀번호 *</span>
                  <input name="password" type="password" required class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
                </label>
                <button
                  type="submit"
                  class="w-fit rounded-full bg-ink px-6 py-2.5 text-sm font-semibold text-paper transition hover:bg-signal-deep"
                >
                  로그인
                </button>
                <p class="signin-msg hidden text-sm"></p>
                <button type="button" data-forgot-toggle class="w-fit text-xs font-medium text-soft underline underline-offset-4 hover:text-ink">
                  비밀번호 찾기
                </button>
              </form>
              <form id="forgot-form" class="mt-4 hidden rounded-xl border border-line bg-paper p-4">
                <label class="block text-sm">
                  <span class="font-medium">가입한 이메일</span>
                  <input name="email" type="email" required class="mt-1 w-full rounded-lg border border-line bg-surface px-3 py-2" />
                </label>
                <button
                  type="submit"
                  class="mt-3 w-fit rounded-full border border-ink/20 bg-surface px-5 py-2 text-sm font-semibold text-ink transition hover:border-ink"
                >
                  재설정 메일 받기
                </button>
                <p class="forgot-msg mt-2 hidden text-sm"></p>
              </form>
            </div>

            <div data-panel="signup" hidden>
              <form id="signup-form" class="mt-5 grid gap-4">
                <label class="text-sm">
                  <span class="font-medium">이름 * (바이라인에 표시됩니다)</span>
                  <input name="name" required maxlength="40" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
                </label>
                <label class="text-sm">
                  <span class="font-medium">이메일 *</span>
                  <input name="email" type="email" required class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
                </label>
                <label class="text-sm">
                  <span class="font-medium">비밀번호 * (8자 이상)</span>
                  <input name="password" type="password" required minlength="8" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
                </label>
                <button
                  type="submit"
                  class="w-fit rounded-full bg-ink px-6 py-2.5 text-sm font-semibold text-paper transition hover:bg-signal-deep"
                >
                  회원가입
                </button>
                <p class="signup-msg hidden text-sm"></p>
              </form>
            </div>
          </div>
        </div>
      )
    }

    {
      sessionUser && (
        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-soft">
          <span class="rounded-full border border-line bg-surface px-3 py-1">
            {ROLE_LABELS[parseRoles(sessionUser.role)[0] as Role] ?? '회원'}
          </span>
          <span class="rounded-full border border-line bg-surface px-3 py-1">
            {sessionUser.membership === 'paid' ? '유료 구독' : '무료 회원'}
          </span>
          <span class="truncate">{sessionUser.email}</span>
          <button type="button" id="logout-btn" data-auth-base={authBase} class="ml-auto text-xs font-medium text-soft underline underline-offset-4 hover:text-ink">
            로그아웃
          </button>
        </div>
      )
    }

    {
      sessionUser && !staff && application?.status === 'pending' && (
        <div class="mt-8 rounded-2xl border border-line bg-surface p-6 text-sm leading-relaxed text-soft">
          <p class="font-medium text-ink">에디터 신청이 승인 대기 중입니다.</p>
          <p class="mt-2">
            검토 후 결과를 이메일(<strong>{sessionUser.email}</strong>)로 안내드립니다.
          </p>
        </div>
      )
    }

    {
      sessionUser && !staff && application?.status === 'rejected' && (
        <div class="mt-8 rounded-2xl border border-line bg-surface p-6 text-sm leading-relaxed text-soft">
          <p class="font-medium text-ink">이전 신청이 반려되었습니다.</p>
          {application.note && <p class="mt-2">사유: {application.note}</p>}
          <button
            type="button"
            id="apply-btn"
            class="mt-4 rounded-full bg-ink px-6 py-2.5 text-sm font-semibold text-paper transition hover:bg-signal-deep"
          >
            다시 신청하기
          </button>
          <p class="apply-msg mt-2 hidden text-sm"></p>
        </div>
      )
    }

    {
      sessionUser && !staff && !application && (
        <div class="mt-8 rounded-2xl border border-line bg-surface p-6 text-sm leading-relaxed text-soft">
          <p class="font-medium text-ink">에디터로 활동하기</p>
          <p class="mt-2">
            초안 작성, 검토 큐, 조회수·좋아요 기반 정산이 포털에서 진행됩니다. 신청 후 관리자
            승인 시 활성화되며 결과는 이메일로 안내됩니다.
          </p>
          <button
            type="button"
            id="apply-btn"
            class="mt-4 rounded-full bg-signal px-6 py-2.5 text-sm font-semibold text-paper transition hover:bg-signal-deep"
          >
            에디터 신청하기
          </button>
          <p class="apply-msg mt-2 hidden text-sm"></p>
        </div>
      )
    }

    {
      isModeratorOnly && (
        <div class="mt-8 rounded-2xl border border-line bg-surface p-6 text-sm leading-relaxed text-soft">
          모더레이터 권한으로 월간 지표 리포트에 접근할 수 있습니다:
          <a href="/api/metrics/report" class="ml-1 font-medium text-ink underline underline-offset-4">
            리포트 열기
          </a>
        </div>
      )
    }

    {
      sessionUser && onboarding && (
        <form id="onboard-form" class="mt-8 rounded-2xl border border-line bg-surface p-6">
          <p class="font-display text-xl font-semibold">리뷰어 프로필 등록</p>
          <p class="mt-2 text-sm leading-relaxed text-soft">
            에디터 권한이 있습니다. 작성자 프로필을 등록하면 리뷰 바이라인과 정산에 연결됩니다.
          </p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <label class="text-sm">
              <span class="font-medium">표시 이름 *</span>
              <input name="name" required maxlength="40" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
            </label>
            <label class="text-sm">
              <span class="font-medium">URL 슬러그 (소문자-하이픈) *</span>
              <input name="slug" required pattern="[a-z0-9][a-z0-9-]{1,39}" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
            </label>
            <label class="text-sm">
              <span class="font-medium">역할</span>
              <input name="role" maxlength="30" placeholder="리뷰어" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
            </label>
            <label class="text-sm">
              <span class="font-medium">웹사이트 (선택)</span>
              <input name="url" type="url" placeholder="https://" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2" />
            </label>
            <label class="text-sm sm:col-span-2">
              <span class="font-medium">소개 *</span>
              <textarea name="bio" required maxlength="400" rows="3" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2"></textarea>
            </label>
          </div>
          <p class="mt-3 text-xs text-soft">
            등록 시 작성자 파일이 저장소에 추가되고, 배포 후 사이트에 반영됩니다.
          </p>
          <button
            type="submit"
            class="mt-4 rounded-full bg-ink px-6 py-2.5 text-sm font-semibold text-paper transition hover:bg-signal-deep"
          >
            프로필 등록하기
          </button>
          <p class="onboard-msg mt-3 hidden text-sm"></p>
        </form>
      )
    }

    {
      sessionUser && !onboarding && authorSlug && (
        <>
          <p class="mt-3 text-soft">
            {authorName} ({month}) · 정산 기준: 고유 조회수 {formatKrw(rates.view)} · 좋아요{' '}
            {formatKrw(rates.like)} · 월 상한 {formatKrw(rates.cap)}
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-line bg-surface p-5">
              <p class="eyebrow text-soft">이번 달 조회수</p>
              <p class="mt-2 font-display text-3xl font-semibold tabular-nums">
                {totals.monthViews.toLocaleString('ko-KR')}
              </p>
            </div>
            <div class="rounded-2xl border border-line bg-surface p-5">
              <p class="eyebrow text-soft">이번 달 좋아요</p>
              <p class="mt-2 font-display text-3xl font-semibold tabular-nums">
                {totals.monthLikes.toLocaleString('ko-KR')}
              </p>
            </div>
            <div class="rounded-2xl border border-signal/40 bg-surface p-5">
              <p class="eyebrow text-signal-deep">이번 달 예상 정산</p>
              <p class="mt-2 font-display text-3xl font-semibold text-signal tabular-nums">
                {formatKrw(estimate)}
              </p>
            </div>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <a
              href="/reviewer/drafts/"
              class="rounded-2xl border border-line bg-surface p-5 transition hover:border-ink"
            >
              <p class="eyebrow text-signal-deep">리뷰 집필</p>
              <p class="mt-2 font-display text-lg font-semibold">초안 작성 · 관리 →</p>
              <p class="mt-1 text-xs text-soft">MDX 초안을 쓰고 검토 큐로 제출하세요.</p>
            </a>
            {
              hasRole(sessionUser, 'admin') && (
                <a
                  href="https://admin.gearpro.kr/"
                  class="rounded-2xl border border-line bg-surface p-5 transition hover:border-ink"
                >
                  <p class="eyebrow text-signal-deep">관리자</p>
                  <p class="mt-2 font-display text-lg font-semibold">관리자 콘솔 →</p>
                  <p class="mt-1 text-xs text-soft">
                    초안 검토, 에디터 승인, 사용자 관리. Cloudflare Access로 보호됩니다.
                  </p>
                </a>
              )
            }
            <a
              href="/about/"
              class="rounded-2xl border border-line bg-surface p-5 transition hover:border-ink"
            >
              <p class="eyebrow text-signal-deep">안내</p>
              <p class="mt-2 font-display text-lg font-semibold">리뷰 원칙 →</p>
              <p class="mt-1 text-xs text-soft">기어프로의 리뷰 방식과 정산 정책.</p>
            </a>
          </div>

          <div class="mt-10 overflow-hidden rounded-2xl border border-line bg-surface">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-line text-left text-xs uppercase tracking-widest text-soft">
                  <th class="px-4 py-3 font-medium">리뷰</th>
                  <th class="px-4 py-3 text-right font-medium">월 조회</th>
                  <th class="px-4 py-3 text-right font-medium">월 좋아요</th>
                  <th class="px-4 py-3 text-right font-medium">누적 조회</th>
                  <th class="px-4 py-3 text-right font-medium">누적 좋아요</th>
                </tr>
              </thead>
              <tbody>
                {
                  slugStats.map((s) => (
                    <tr class="border-b border-line last:border-b-0">
                      <td class="px-4 py-3 font-medium">
                        <a href={`/reviews/${s.slug}/`} class="hover:underline">
                          {s.title}
                        </a>
                      </td>
                      <td class="px-4 py-3 text-right tabular-nums">{s.monthViews.toLocaleString('ko-KR')}</td>
                      <td class="px-4 py-3 text-right tabular-nums">{s.monthLikes.toLocaleString('ko-KR')}</td>
                      <td class="px-4 py-3 text-right tabular-nums text-soft">{s.allViews.toLocaleString('ko-KR')}</td>
                      <td class="px-4 py-3 text-right tabular-nums text-soft">{s.allLikes.toLocaleString('ko-KR')}</td>
                    </tr>
                  ))
                }
                {
                  slugStats.length === 0 && (
                    <tr>
                      <td colspan="5" class="px-4 py-6 text-center text-soft">
                        아직 발행된 리뷰가 없습니다.
                      </td>
                    </tr>
                  )
                }
              </tbody>
            </table>
          </div>

          <div class="mt-10 rounded-2xl border border-line bg-surface p-6">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <p class="eyebrow text-soft">{month} 정산 요청</p>
                {
                  currentRequest ? (
                    <p class="mt-2 text-sm">
                      상태: <strong>{statusLabel[currentRequest.status] ?? currentRequest.status}</strong> ·
                      금액 {formatKrw(currentRequest.amount)}
                    </p>
                  ) : (
                    <p class="mt-2 text-sm text-soft">
                      예상 정산 {formatKrw(estimate)}을 요청할 수 있습니다.
                    </p>
                  )
                }
              </div>
              {
                currentRequest ? (
                  <span
                    class:list={[
                      'rounded-full px-5 py-2.5 text-sm font-semibold',
                      currentRequest.status === 'paid'
                        ? 'bg-ink text-paper'
                        : 'border border-line text-soft',
                    ]}
                  >
                    {statusLabel[currentRequest.status] ?? currentRequest.status}
                  </span>
                ) : (
                  <button
                    type="button"
                    id="payout-btn"
                    data-month={month}
                    class="rounded-full bg-signal px-5 py-2.5 text-sm font-semibold text-paper transition hover:bg-signal-deep"
                  >
                    정산 요청하기
                  </button>
                )
              }
            </div>
            <p class="mt-3 text-xs text-soft">
              요청 금액은 조회수·좋아요 집계 기준의 예상치이며, 최종 지급액은 관리자 확인 후 확정됩니다.
            </p>
          </div>

          {
            history.length > 0 && (
              <div class="mt-8">
                <p class="eyebrow text-soft">요청 내역</p>
                <div class="mt-4 overflow-hidden rounded-2xl border border-line bg-surface">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="border-b border-line text-left text-xs uppercase tracking-widest text-soft">
                        <th class="px-4 py-3 font-medium">월</th>
                        <th class="px-4 py-3 text-right font-medium">조회수</th>
                        <th class="px-4 py-3 text-right font-medium">좋아요</th>
                        <th class="px-4 py-3 text-right font-medium">금액</th>
                        <th class="px-4 py-3 text-right font-medium">상태</th>
                      </tr>
                    </thead>
                    <tbody>
                      {
                        history.map((r) => (
                          <tr class="border-b border-line last:border-b-0">
                            <td class="px-4 py-3 tabular-nums">{r.month}</td>
                            <td class="px-4 py-3 text-right tabular-nums">{r.views.toLocaleString('ko-KR')}</td>
                            <td class="px-4 py-3 text-right tabular-nums">{r.likes.toLocaleString('ko-KR')}</td>
                            <td class="px-4 py-3 text-right font-medium tabular-nums">{formatKrw(r.amount)}</td>
                            <td class="px-4 py-3 text-right">{statusLabel[r.status] ?? r.status}</td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            )
          }
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  const authBase =
    document.querySelector<HTMLElement>('[data-auth-base]')?.dataset.authBase ?? '';

  const loginButtons = document.querySelectorAll<HTMLButtonElement>('[data-provider]');
  for (const btn of loginButtons) {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      try {
        const res = await fetch(`${authBase}/api/auth/sign-in/social`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            provider: btn.dataset.provider,
            callbackURL: `${window.location.origin}/reviewer/`,
          }),
        });
        const data = (await res.json()) as { url?: string };
        if (data.url) {
          window.location.href = data.url;
        } else {
          btn.disabled = false;
        }
      } catch {
        btn.disabled = false;
      }
    });
  }

  const logoutBtn = document.querySelector<HTMLButtonElement>('#logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      const base = logoutBtn.dataset.authBase ?? '';
      await fetch(`${base}/api/auth/sign-out`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({}),
      }).catch(() => {});
      window.location.reload();
    });
  }

  const onboardForm = document.querySelector<HTMLFormElement>('#onboard-form');
  if (onboardForm) {
    const msg = onboardForm.querySelector<HTMLElement>('.onboard-msg')!;
    onboardForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(onboardForm);
      const res = await fetch('/api/reviewer/onboard', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(fd.entries())),
      });
      const data = (await res.json()) as { ok: boolean; error?: string };
      if (data.ok) {
        msg.classList.remove('hidden');
        msg.textContent = '등록 완료! 대시보드로 이동합니다…';
        setTimeout(() => window.location.reload(), 1200);
      } else {
        msg.classList.remove('hidden');
        msg.textContent = `등록 실패: ${data.error ?? 'unknown'}`;
      }
    });
  }

  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab ?? 'signin';
      for (const t of tabs) {
        t.dataset.active = String(t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      }
      for (const p of panels) {
        p.hidden = p.dataset.panel !== target;
      }
    });
  }

  function bindEmailAuth(
    formId: string,
    msgClass: string,
    endpoint: string,
    withName: boolean,
  ) {
    const form = document.querySelector<HTMLFormElement>(`#${formId}`);
    if (!form) return;
    const msg = form.querySelector<HTMLElement>(msgClass)!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      msg.classList.remove('hidden');
      msg.textContent = '처리 중…';
      try {
        const payload: Record<string, string> = {
          email: String(fd.get('email') ?? ''),
          password: String(fd.get('password') ?? ''),
        };
        if (withName) payload.name = String(fd.get('name') ?? '');
        const res = await fetch(`${authBase}${endpoint}`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          const data = (await res.json().catch(() => ({}))) as { message?: string };
          msg.textContent = data.message ?? '실패했습니다. 입력값을 확인하세요.';
        }
      } catch {
        msg.textContent = '네트워크 오류입니다. 다시 시도하세요.';
      }
    });
  }

  bindEmailAuth('signin-form', '.signin-msg', '/api/auth/sign-in/email', false);
  bindEmailAuth('signup-form', '.signup-msg', '/api/auth/sign-up/email', true);

  const forgotToggle = document.querySelector<HTMLButtonElement>('[data-forgot-toggle]');
  const forgotForm = document.querySelector<HTMLFormElement>('#forgot-form');
  if (forgotToggle && forgotForm) {
    forgotToggle.addEventListener('click', () => {
      forgotForm.classList.toggle('hidden');
    });
    const forgotMsg = forgotForm.querySelector<HTMLElement>('.forgot-msg')!;
    forgotForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = String(new FormData(forgotForm).get('email') ?? '');
      forgotMsg.classList.remove('hidden');
      forgotMsg.textContent = '전송 중…';
      try {
        const res = await fetch(`${authBase}/api/auth/request-password-reset`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, redirectTo: `${window.location.origin}/reset-password/` }),
        });
        const data = (await res.json()) as { status?: boolean };
        forgotMsg.textContent =
          data.status || res.ok
            ? '메일을 보냈습니다. 받은 편지함을 확인하세요.'
            : '전송에 실패했습니다.';
      } catch {
        forgotMsg.textContent = '네트워크 오류입니다. 다시 시도하세요.';
      }
    });
  }

  const applyBtn = document.querySelector<HTMLButtonElement>('#apply-btn');
  const applyMsg = document.querySelector<HTMLElement>('.apply-msg');
  if (applyBtn) {
    applyBtn.addEventListener('click', async () => {
      applyBtn.disabled = true;
      if (applyMsg) {
        applyMsg.classList.remove('hidden');
        applyMsg.textContent = '신청 처리 중…';
      }
      try {
        const res = await fetch('/api/reviewer/apply', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({}),
        });
        const data = (await res.json()) as { ok: boolean; error?: string };
        if (data.ok) {
          window.location.reload();
        } else {
          applyBtn.disabled = false;
          if (applyMsg) applyMsg.textContent = `신청 실패: ${data.error ?? 'unknown'}`;
        }
      } catch {
        applyBtn.disabled = false;
        if (applyMsg) applyMsg.textContent = '네트워크 오류입니다. 다시 시도하세요.';
      }
    });
  }

  const payoutBtn = document.querySelector<HTMLButtonElement>('#payout-btn');
  if (payoutBtn) {
    payoutBtn.addEventListener('click', async () => {
      payoutBtn.disabled = true;
      payoutBtn.textContent = '요청 중…';
      try {
        const res = await fetch('/api/reviewer/payout', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ month: payoutBtn.dataset.month }),
        });
        const data = (await res.json()) as { ok: boolean };
        if (data.ok) {
          window.location.reload();
        } else {
          payoutBtn.textContent = '요청 실패 — 새로고침 후 다시 시도';
        }
      } catch {
        payoutBtn.textContent = '요청 실패 — 새로고침 후 다시 시도';
        payoutBtn.disabled = false;
      }
    });
  }
</script>
