---
import { getCollection } from 'astro:content';

import ReviewCard from '../../components/ReviewCard.astro';
import BaseLayout from '../../layouts/Base.astro';
import { buildTaxonomy, byDateDesc } from '../../lib/taxonomy';

const reviews = (await getCollection('reviews')).sort(byDateDesc);
const categories = await getCollection('categories');
const taxonomy = buildTaxonomy(categories);
const authorNames = new Map((await getCollection('authors')).map((a) => [a.id, a.data.name]));
const parentsWithChildren = taxonomy.topLevel.filter(
  (c) => (taxonomy.childrenOf.get(c.id)?.length ?? 0) > 0,
);
---

<BaseLayout title="전체 리뷰" description="기어프로의 모든 리뷰. 카테고리별로 필터링해 보세요.">
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-20">
    <h1 class="font-display text-4xl font-semibold tracking-tight md:text-6xl">모든 리뷰</h1>
    <p class="mt-3 text-soft">
      {reviews.length}개 제품, 각각 몇 달의 사용 기간, 그리고 솔직한 점수.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="리뷰 성격 필터">
      <button type="button" data-funding="all" class="filter-chip filter-chip-sm" data-active="true">
        전체
      </button>
      <button type="button" data-funding="self" class="filter-chip filter-chip-sm">내돈내산</button>
      <button type="button" data-funding="sponsor" class="filter-chip filter-chip-sm">스폰서</button>
    </div>

    <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="카테고리별 리뷰 필터">
      <button type="button" data-filter="all" class="filter-chip" data-active="true">전체</button>
      {
        taxonomy.topLevel.map((category) => (
          <button type="button" data-filter={category.id} class="filter-chip">
            {category.data.name}
          </button>
        ))
      }
    </div>

    {
      parentsWithChildren.map((parent) => (
        <div class="mt-2 flex flex-wrap gap-2" data-subrow={parent.id} hidden>
          {taxonomy.childrenOf.get(parent.id)!.map((child) => (
            <button type="button" data-filter={child} class="filter-chip filter-chip-sm">
              › {taxonomy.nameOf(child)}
            </button>
          ))}
        </div>
      ))
    }

    <div id="review-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        reviews.map((review) => (
          <ReviewCard
            review={review}
            authorName={authorNames.get(review.data.author)}
            categoryLabel={taxonomy.labelOf(review.data.category)}
          />
        ))
      }
    </div>
    <p id="empty-state" class="mt-10 hidden text-sm text-soft">
      이 카테고리의 리뷰가 아직 없습니다. 조금만 기다려 주세요.
    </p>
  </section>
</BaseLayout>

<script type="application/json" data-taxonomy is:inline
  set:html={JSON.stringify({ children: Object.fromEntries(taxonomy.childrenOf) })}
/>

<script>
  const taxonomy = JSON.parse(
    document.querySelector<HTMLScriptElement>('[data-taxonomy]')?.textContent ?? '{}',
  ) as { children: Record<string, string[]> };

  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const fundingChips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-funding]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
  const subrows = Array.from(document.querySelectorAll<HTMLElement>('[data-subrow]'));
  const emptyState = document.getElementById('empty-state');
  const validSlugs = new Set(chips.map((c) => c.dataset.filter ?? ''));
  function descendants(slug: string): string[] {
    const out: string[] = [];
    const stack = [...(taxonomy.children[slug] ?? [])];
    while (stack.length) {
      const s = stack.pop() as string;
      out.push(s);
      stack.push(...(taxonomy.children[s] ?? []));
    }
    return out;
  }

  function parentOf(slug: string): string | undefined {
    for (const [parent, kids] of Object.entries(taxonomy.children)) {
      if (kids.includes(slug)) return parent;
    }
    return undefined;
  }

  let activeCategory = 'all';
  let activeFunding = 'all';

  function apply() {
    const allowed =
      activeCategory === 'all' ? null : new Set([activeCategory, ...descendants(activeCategory)]);
    let visible = 0;
    for (const card of cards) {
      const show =
        (!allowed || allowed.has(card.dataset.category ?? '')) &&
        (activeFunding === 'all' || card.dataset.funding === activeFunding);
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    }
    for (const chip of chips) {
      chip.dataset.active = String(chip.dataset.filter === activeCategory);
    }
    for (const chip of fundingChips) {
      chip.dataset.active = String(chip.dataset.funding === activeFunding);
    }
    const rowOwner =
      activeCategory === 'all'
        ? undefined
        : (taxonomy.children[activeCategory]?.length ? activeCategory : parentOf(activeCategory));
    for (const row of subrows) {
      row.hidden = row.dataset.subrow !== rowOwner;
    }
    emptyState?.classList.toggle('hidden', visible > 0);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      activeCategory = chip.dataset.filter ?? 'all';
      syncUrl();
      apply();
    });
  }

  for (const chip of fundingChips) {
    chip.addEventListener('click', () => {
      activeFunding = chip.dataset.funding ?? 'all';
      syncUrl();
      apply();
    });
  }

  function syncUrl() {
    const url = new URL(window.location.href);
    if (activeCategory === 'all') {
      url.searchParams.delete('category');
    } else {
      url.searchParams.set('category', activeCategory);
    }
    if (activeFunding === 'all') {
      url.searchParams.delete('funding');
    } else {
      url.searchParams.set('funding', activeFunding);
    }
    window.history.replaceState(null, '', url.pathname + url.search);
  }

  const params = new URLSearchParams(window.location.search);
  const initialCategory = params.get('category');
  if (initialCategory && validSlugs.has(initialCategory)) activeCategory = initialCategory;
  const initialFunding = params.get('funding');
  if (initialFunding === 'self' || initialFunding === 'sponsor') activeFunding = initialFunding;
  apply();
</script>
