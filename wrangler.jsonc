{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gearpro",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "gearpro.kr",
      "custom_domain": true
    },
    {
      "pattern": "auth.gearpro.kr",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "METRICS_DB",
      "database_name": "gearpro-metrics",
      "database_id": "388d5682-f0a3-4468-9c74-9edbc7eec860"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL_SENDER"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DRAFT_IMAGES",
      "bucket_name": "gearpro-media"
    }
  ],
  "vars": {
    "SITE_URL": "https://gearpro.kr",
    "KEYSTATIC_GITHUB_REPO": "gearprokr/gearpro",
    "BETTER_AUTH_URL": "https://auth.gearpro.kr",
    "ADMIN_EMAILS": "clee11@gmail.com"
  }
}
